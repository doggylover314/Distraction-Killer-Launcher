# Copy to keystore.properties and fill in. That file is gitignored: the real
# key and password must never be committed, because this repository is public.
# Environment variables win over this file, so CI can use DK_KEYSTORE,
# DK_STORE_PASSWORD, DK_KEY_ALIAS and DK_KEY_PASSWORD instead.
storeFile=signing/distraction-killer.jks
storePassword=CHANGE_ME
keyAlias=distraction-killer
keyPassword=CHANGE_ME
