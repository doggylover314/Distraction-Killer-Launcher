<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws all of the UI, so this theme only needs to give the
         window a sane background and no action bar. Using a platform parent
         keeps AppCompat / Material Components out of the dependency list. -->
    <style name="Theme.DistractionKiller" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Forced variants, chosen in code before onCreate so a Light theme on a
         dark phone (or the reverse) does not flash the wrong shade. -->
    <style name="Theme.DistractionKiller.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>
    <style name="Theme.DistractionKiller.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>
</resources>
